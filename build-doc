#!/bin/bash

# Build the documentation into docs/_build/html, with the same settings as Read the Docs.
# Use like this: ./build-doc [extra sphinx-build options]
# for example ./build-doc -n (nitpicky mode)
#
# The first run creates a virtual environment in build/doc-venv and installs the 'doc'
# dependencies of pyproject.toml in it; it is updated whenever pyproject.toml changes.
# Set PYTHON to choose the interpreter of that environment (default: python3).

set -e

cd "$(dirname "$0")"

VENV=build/doc-venv
if [ ! -x $VENV/bin/sphinx-build ] || [ pyproject.toml -nt $VENV/.installed ]
then
      ${PYTHON:-python3} -m venv $VENV
      $VENV/bin/pip install -e '.[doc]'
      touch $VENV/.installed
fi

$VENV/bin/sphinx-build -W --keep-going "$@" docs docs/_build/html

echo "Documentation built: docs/_build/html/index.html"
