#!/bin/bash

# Run the test suite on this machine: no board, no Renode, no serial port.
# Use like this: ./testit [pytest options]
# for example ./testit -k sync
#             ./testit --debug-friendly -k test_basic_example   (no timeouts, for single-step debugging)
#             ./testit -m 'not native'                           (pure Python tests only, no C compiler needed)
#
# The first run creates a virtual environment in build/test-venv and installs the 'test' dependencies of
# pyproject.toml in it; it is updated whenever pyproject.toml changes. Set PYTHON to choose the interpreter of
# that environment (default: python3), CC to choose the C compiler (default: cc) and CFLAGS to add flags.

set -e

cd "$(dirname "$0")"

VENV=build/test-venv
if [ ! -x $VENV/bin/pytest ] || [ pyproject.toml -nt $VENV/.installed ]
then
      ${PYTHON:-python3} -m venv $VENV
      $VENV/bin/pip install -e '.[test]'
      touch $VENV/.installed
fi

exec $VENV/bin/python -m pytest "$@"
